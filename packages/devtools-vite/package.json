{
  "name": "@dalpeng/devtools-vite",
  "type": "module",
  "version": "0.1.0",
  "description": "Vite plugin to auto-inject @dalpeng/devtools in dev mode",
  "main": "./dist/dalpeng-devtools-vite.umd.cjs",
  "module": "./dist/dalpeng-devtools-vite.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dalpeng-devtools-vite.js",
      "require": "./dist/dalpeng-devtools-vite.umd.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threedalpeng/dalpeng.git"
  },
  "homepage": "https://github.com/threedalpeng/dalpeng/packages/devtools-vite#readme",
  "author": "Kim Jeong-Won <threedalpeng@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:dev": "vite build --mode development"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@dalpeng/core": "workspace:^0.1.0",
    "@dalpeng/devtools": "workspace:^0.1.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  }
}
